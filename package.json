{
  "name": "eslint-config-radiofrance",
  "version": "8.2.0-1",
  "description": "ESLint shareable config for Radio France",
  "license": "CECILL-B",
  "repository": "radiofrance/eslint-config-radiofrance",
  "author": {
    "name": "Radio France",
    "email": "opensource@radiofrance.com",
    "url": "https://www.radiofrance.fr"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "source/config.js",
  "types": "source/config.d.ts",
  "exports": {
    "types": "./source/config.d.ts",
    "default": "./source/config.js"
  },
  "scripts": {
    "build-check": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --config test/vitest.config.js"
  },
  "files": [
    "source"
  ],
  "keywords": [
    "❤️",
    "space",
    "spaces",
    "eslintconfig",
    "xo",
    "code",
    "quality",
    "style",
    "lint",
    "linter",
    "jscs",
    "jshint",
    "jslint",
    "eslint",
    "validate",
    "code style",
    "standard",
    "strict",
    "check",
    "checker",
    "verify",
    "enforce",
    "hint",
    "simple",
    "sindre"
  ],
  "dependencies": {
    "@eslint/compat": "^2.0.5",
    "eslint-config-xo": "^0.53.2",
    "eslint-plugin-promise": "^7.3.0",
    "prettier": "^3.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "eslint": ">=10.1.0"
  }
}
